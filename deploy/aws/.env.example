# Configuración del servidor en AWS. En el servidor va en /opt/trackit/.env (nunca en git).
# La forma fácil: copia tu deploy/.env y agrégale las cuatro variables de este bloque.

# ── Propias de AWS ───────────────────────────────────────
# Dominio con HTTPS. Sin dominio propio usa la IP elástica con guiones + .sslip.io
# Ej.: IP 3.90.12.34  →  DOMINIO=3-90-12-34.sslip.io
DOMINIO=
# Correo para los avisos de Let's Encrypt (certificados)
CORREO_ADMIN=
# Tu usuario de GitHub en minúsculas (dueño de las imágenes en ghcr.io)
GHCR_OWNER=giovannistiveng
# Versión de las imágenes (latest = la última publicada en main)
VERSION_API=latest
VERSION_WEB=latest

# ── Igual que deploy/.env ────────────────────────────────
DB_NAME=trackit_express
DB_USER=trackit
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=24h
NOMINATIM_CONTACT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NEQUI_MODO=simulado
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
