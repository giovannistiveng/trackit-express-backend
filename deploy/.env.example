# Copia este archivo como deploy/.env y completa los valores. NUNCA subas deploy/.env a git.

# ── General ──────────────────────────────────────────────
# Puerto del equipo donde se abre la aplicación
WEB_PORT=8080
# Dirección con la que los usuarios abren la app (con dominio y HTTPS en producción)
PUBLIC_URL=http://localhost:8080

# ── Base de datos (la crea el contenedor "db") ───────────
DB_NAME=trackit_express
DB_USER=trackit
DB_PASSWORD=cambia-esta-contrasena

# ── Seguridad ────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── APIs externas (opcionales: vacías = modo de desarrollo) ─
NOMINATIM_CONTACT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TrackIt Express <no-responder@trackit.com.co>
NEQUI_MODO=simulado
NEQUI_CLIENT_ID=
NEQUI_CLIENT_SECRET=
NEQUI_API_KEY=
NEQUI_CODIGO_COMERCIO=NIT_1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@trackit.com.co
FCM_SERVICE_ACCOUNT_FILE=
