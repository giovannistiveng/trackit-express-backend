# Entorno del backend para las pruebas de carga y estrés con JMeter.
# Copia este archivo como carga/.env.carga (no se sube a git) y ajusta la base de datos.
# Úsalo con:  npm run carga:preparar   y   npm run carga:servidor

NODE_ENV=production
PORT=3000

# Base de datos SOLO para carga: las pruebas crean miles de usuarios y envíos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trackit_carga
DB_SSL=false

# Cualquier texto largo; no reutilices el de producción
JWT_SECRET=secreto-solo-para-pruebas-de-carga-cambialo-1234567890

# Sin límite de peticiones por IP: JMeter manda todo desde un mismo equipo
RATE_LIMIT_DISABLED=true
# Rutas estimadas sin consultar OpenStreetMap (no abusar de servicios públicos ni medirlos a ellos)
GEO_MODO=sin-red
# Pagos simulados: Nequi aprueba a los 2 segundos
NEQUI_MODO=simulado
NEQUI_SIMULADO_SEGUNDOS=2
# Correo, push y archivos desactivados: no se envía nada real (vacías tapan los valores de tu .env)
SMTP_HOST=
FCM_SERVICE_ACCOUNT_FILE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=

# Menos registro en disco para no medir el log
LOG_LEVEL=WARN
LOG_TO_CONSOLE=false
LOG_DIR=logs/carga
