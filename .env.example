# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# URL pública del backend (enlaces a archivos cuando se guardan en disco)
PUBLIC_URL=http://localhost:3000
# Orígenes permitidos por CORS, separados por coma (vacío = cualquiera; en producción, pon la URL del frontend)
CORS_ORIGINS=http://localhost:4200

# ── Base de datos PostgreSQL ─────────────────────────────
# Opción 1: URL completa (Render, Railway, Neon…). Tiene prioridad sobre los campos sueltos.
DATABASE_URL=
# Opción 2: campos sueltos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_NAME=trackit_express
# true si el proveedor exige SSL
DB_SSL=false

# ── Seguridad ────────────────────────────────────────────
# En producción: al menos 32 caracteres aleatorios (el servidor no arranca con el valor por defecto)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_32+
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# ── Archivos (documentos y fotos de entrega) ─────────────
# Si Cloudinary está configurado se usa; si no, se guardan en UPLOADS_DIR y se sirven en /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADS_DIR=uploads

# ── Mapas (OpenStreetMap / Nominatim, no requiere API key) ──
# Correo de contacto que Nominatim exige en cada consulta de direcciones
NOMINATIM_CONTACT=soporte@trackit.com.co

# ── Logs (archivos .txt en LOG_DIR) ──────────────────────
LOG_DIR=logs
# DEBUG | INFO | WARN | ERROR  (por defecto DEBUG en desarrollo, INFO en producción)
LOG_LEVEL=DEBUG
LOG_RETENTION_DAYS=30
LOG_TO_CONSOLE=true

# ── Pruebas (npm test) ───────────────────────────────────
# Base que las pruebas BORRAN y recrean; debe contener "test" en el nombre
TEST_DB_NAME=trackit_test

# ── Frontend y correo ────────────────────────────────────
# URL del frontend: se usa en los enlaces de los correos
FRONTEND_URL=http://localhost:4200
# SMTP (Gmail, Outlook, SendGrid, Brevo…). Si SMTP_HOST está vacío, los correos se guardan
# en logs/correos/*.html y el enlace aparece en el log: ideal para desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TrackIt Express <no-responder@trackit.com.co>

# ── Pagos con Nequi ──────────────────────────────────────
# simulado: no cobra de verdad (aprueba a los NEQUI_SIMULADO_SEGUNDOS; celular *0000 rechaza, *9999 vence)
# conecta: Nequi real (API Nequi Conecta); pide las credenciales en conecta.nequi.com.co
NEQUI_MODO=simulado
NEQUI_SIMULADO_SEGUNDOS=8
NEQUI_CLIENT_ID=
NEQUI_CLIENT_SECRET=
NEQUI_API_KEY=
NEQUI_AUTH_URL=https://oauth.nequi.com/oauth2/token
NEQUI_API_URL=https://api.nequi.com
NEQUI_CODIGO_COMERCIO=NIT_1

# ── Notificaciones push ──────────────────────────────────
# Web Push (navegador / PWA). Vacías: se generan solas y se guardan en .vapid.json (no lo subas a git).
# Para fijarlas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@trackit.com.co
# App Android/iOS (Capacitor): ruta al JSON de la cuenta de servicio de Firebase (no lo subas a git)
FCM_SERVICE_ACCOUNT_FILE=
# Archivo donde se guardan las claves VAPID generadas (por defecto .vapid.json)
VAPID_FILE=
