# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# URL pública del backend (enlaces a archivos cuando se guardan en disco)
PUBLIC_URL=http://localhost:3000
# Orígenes permitidos por CORS, separados por coma (vacío = cualquiera; en producción, pon la URL del frontend)
CORS_ORIGINS=http://localhost:4200

# ── Base de datos PostgreSQL ─────────────────────────────
# Opción 1: URL completa (Render, Railway, Neon…). Tiene prioridad sobre los campos sueltos.
DATABASE_URL=
# Opción 2: campos sueltos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_NAME=trackit_express
# true si el proveedor exige SSL
DB_SSL=false

# ── Seguridad ────────────────────────────────────────────
# En producción: al menos 32 caracteres aleatorios (el servidor no arranca con el valor por defecto)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_32+
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# ── Archivos (documentos y fotos de entrega) ─────────────
# Si Cloudinary está configurado se usa; si no, se guardan en UPLOADS_DIR y se sirven en /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADS_DIR=uploads

# ── Logs (archivos .txt en LOG_DIR) ──────────────────────
LOG_DIR=logs
# DEBUG | INFO | WARN | ERROR  (por defecto DEBUG en desarrollo, INFO en producción)
LOG_LEVEL=DEBUG
LOG_RETENTION_DAYS=30
LOG_TO_CONSOLE=true

# ── Pruebas (npm test) ───────────────────────────────────
# Base que las pruebas BORRAN y recrean; debe contener "test" en el nombre
TEST_DB_NAME=trackit_test
