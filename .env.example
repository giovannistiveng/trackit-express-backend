# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_NAME=trackit_express

# Seguridad
JWT_SECRET=cualquier_cosa_secreta_aqui_123
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# APIs externas (OpenStreetMap no requiere API key, pero dejamos la variable por compatibilidad)
OPENSTREET_API_KEY=opcional_no_requerido
CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret
TWILIO_ACCOUNT_SID=tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_PHONE_NUMBER=tu_twilio_phone_number